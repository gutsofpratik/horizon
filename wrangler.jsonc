{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "horizons-lab",
  "main": "worker/index.ts",
  "account_id": "bb3ace6c8f2b439b9952b07624e2adc7",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "d1_databases": [{ "binding": "DB", "database_name": "horizons-lab-forms", "database_id": "7ff6dc1e-dba1-466d-a2f5-b60710dac59f" }],
  "routes": [{ "pattern": "openhorizonlab.org", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
